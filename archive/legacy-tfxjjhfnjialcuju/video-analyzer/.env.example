# 视频内容分析器配置

# 应用配置
APP_NAME=视频内容分析器
DEBUG=false
VERSION=0.1.0

# 服务配置
HOST=0.0.0.0
PORT=8000

# 上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# 允许的视频格式
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv,webm,flv,wmv,m4v

# 分析配置
FRAME_SAMPLE_RATE=1
MAX_FRAMES_TO_ANALYZE=100

# Whisper 模型: tiny/base/small/medium/large
AUDIO_MODEL=base

# 画面分析开关
ENABLE_OBJECT_DETECTION=true
ENABLE_SCENE_RECOGNITION=true
ENABLE_FACE_DETECTION=false
