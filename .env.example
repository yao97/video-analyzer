# ── Video Content Analyzer 部署环境变量 ──
# 复制本文件为 .env 后按需修改：cp .env.example .env

# 服务端口（宿主机映射）
API_PORT=8766

# ── 语音识别（Qwen3-ASR-1.7B 本地大模型） ──
# 模型文件需放入 backend/qwen3_asr_models/（见 README 部署章节）
# 热词提示：影响识别用词倾向，可自定义领域词减少同音字错误
QWEN3_ASR_CONTEXT=这是中文短视频直播带货内容，注意识别网络用语和口语，例如"夹子音""破价""家人们""闭眼入"等，避免同音字误写。
# 采样温度：越低越保守（0.1-0.4），默认 0.3
QWEN3_ASR_TEMPERATURE=0.3

# ── 深度分析 LLM 提供商 ──
# siliconflow（硅基流动）/ deepseek（DeepSeek官方）/ ollama（本地）/ zhipu（智谱）
LLM_PROVIDER=siliconflow

# API Key（siliconflow/deepseek/zhipu 需要；ollama 不需要）
LLM_API_KEY=

# Ollama 地址：
#  - 使用 compose 内 ollama 服务：http://ollama:11434
#  - 使用宿主机 Ollama：http://host.docker.internal:11434
OLLAMA_BASE=http://ollama:11434

# ── 资源限制（可选，默认值合理） ──
API_MEM_LIMIT=4g
OLLAMA_MEM_LIMIT=8g
