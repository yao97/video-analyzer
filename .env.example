# ── Video Content Analyzer 部署环境变量 ──
# 复制本文件为 .env 后按需修改：cp .env.example .env

# 服务端口（宿主机映射）
API_PORT=8766

# Whisper 转写模型：tiny / base / small（推荐）/ medium
# 模型越大越准越慢；内存紧张用 tiny/base
WHISPER_MODEL=small

# ── 深度分析 LLM 提供商 ──
# siliconflow（硅基流动）/ deepseek（DeepSeek官方）/ ollama（本地）/ zhipu（智谱）
LLM_PROVIDER=siliconflow

# API Key（siliconflow/deepseek/zhipu 需要；ollama 不需要）
LLM_API_KEY=

# Ollama 地址：
#  - 使用 compose 内 ollama 服务：http://ollama:11434
#  - 使用宿主机 Ollama：http://host.docker.internal:11434
OLLAMA_BASE=http://ollama:11434

# ── 资源限制（可选，默认值合理） ──
API_MEM_LIMIT=4g
OLLAMA_MEM_LIMIT=8g
